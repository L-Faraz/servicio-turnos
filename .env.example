DB_NAME=turnos_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5433
TURNOS_PORT=8082
CATALOG_BASE_URL=http://host.docker.internal:8081
CATEDRA_API_URL=http://host.docker.internal:8090
CATEDRA_JWT_TOKEN=
CATEDRA_CONNECT_TIMEOUT_MS=2000
CATEDRA_READ_TIMEOUT_MS=3000
CATEDRA_GROUP_ID=proyecto-l-faraz
CATEDRA_KAFKA_ENABLED=true
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CATEDRA_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
APP_JWT_SECRET=replace-with-at-least-32-bytes
APP_JWT_ISSUER=servicio-turnos
APP_JWT_EXPIRATION_MS=3600000
APP_CORS_ALLOWED_ORIGINS=
TURNOS_AVAILABILITY_MAX_DAYS=31
TURNOS_OUTBOX_ENABLED=true
TURNOS_OUTBOX_MAX_ATTEMPTS=5
TURNOS_OUTBOX_RETRY_INITIAL_MS=2000
TURNOS_OUTBOX_PUBLISH_INTERVAL_MS=2000
